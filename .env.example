# Database. The app connects as kinly_app: a role with no BYPASSRLS that owns
# nothing, so row-level security applies to every query (db/migrations/README.md).
DATABASE_URL="postgresql://kinly_app:password@host/database?sslmode=require"
# The owner role, for applying migrations and the local drift check only.
# Never set it in Vercel.
DATABASE_URL_OWNER="postgresql://owner:password@host/database?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Optional: For production
# NEXTAUTH_URL="https://yourdomain.com"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Planning Center
PCO_APP_ID="your-pco-app-id"
PCO_SECRET="your-pco-secret"

# Secret for the weekly PCO sync cron (/api/cron/pco-sync).
# Vercel Cron sends this automatically as "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret"

# Leadership calendar → Google Calendar push (service account; see README)
# The service account must have "Make changes to events" on the calendar.
GOOGLE_SERVICE_ACCOUNT_EMAIL="calendar-sync@your-project.iam.gserviceaccount.com"
# Paste the private_key from the JSON key; literal \n sequences are converted to newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Each church's calendar id is a church setting now (churches.google_calendar_id).

# Bible APIs
ESV_API_KEY=your_esv_api_key_here
API_BIBLE_KEY=your_api_bible_key_here
API_BIBLE_NBLA_ID=your_nbla_bible_id_here

# The Give button's Church Center address is a church setting now
# (Settings → Church), as are the timezone and the Check-Ins event name.

# Schema drift check (scripts/check-schema-drift.mjs). CI-only: set as GitHub
# repository secrets, not in .env.local. Locally the check falls back to
# DATABASE_URL_OWNER (then DATABASE_URL), which should be the Neon dev branch,
# never production.
#   SCHEMA_SOURCE_URL  read-only role on the database whose schema is the reference
#   SCHEMA_SANDBOX_URL a throwaway Neon branch where schema.sql is built and rolled back
# SCHEMA_SOURCE_URL="postgresql://readonly-user:password@host/database?sslmode=require"
# SCHEMA_SANDBOX_URL="postgresql://user:password@sandbox-host/database?sslmode=require"
