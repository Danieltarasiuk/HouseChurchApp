# Database
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Optional: For production
# NEXTAUTH_URL="https://yourdomain.com"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Planning Center
PCO_APP_ID="your-pco-app-id"
PCO_SECRET="your-pco-secret"

# Secret for the weekly PCO sync cron (/api/cron/pco-sync).
# Vercel Cron sends this automatically as "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret"

# Leadership calendar → Google Calendar push (service account; see README)
# The service account must have "Make changes to events" on the calendar.
GOOGLE_SERVICE_ACCOUNT_EMAIL="calendar-sync@your-project.iam.gserviceaccount.com"
# Paste the private_key from the JSON key; literal \n sequences are converted to newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID="your-calendar-id@group.calendar.google.com"

# Bible APIs
ESV_API_KEY=your_esv_api_key_here
API_BIBLE_KEY=your_api_bible_key_here
API_BIBLE_NBLA_ID=your_nbla_bible_id_here

# Church Center origin for the Give button (opens <origin>/giving). Leave unset to hide it.
NEXT_PUBLIC_CHURCH_CENTER_URL="https://yourchurch.churchcenter.com"
